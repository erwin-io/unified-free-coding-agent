# Copy to .env. Never commit real credentials. Empty keys disable those providers.
# Only explicitly free-model aliases are accepted. No paid fallback.
FREE_ROUTER_KEY=local-agent-only
ROUTER_HOST=127.0.0.1
ROUTER_PORT=4030
PROVIDER_ORDER=kilo,gemini,openrouter
KILO_ENABLED=true
KILO_API_KEY=
KILO_HOURLY_CAP=200
GEMINI_API_KEY=
# Gemini 2.5 Flash free tier is account/project dependent. DO NOT enable paid billing.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MINUTE_CAP=0
GEMINI_DAILY_CAP=0
OPENROUTER_API_KEY=
OPENROUTER_DAILY_CAP=50
ROUTER_RESERVE_PERCENT=10
ROUTER_DB=.agent-runtime/usage.sqlite3
UPSTREAM_TIMEOUT_SECONDS=120

# Absolute path to a LOCAL Git repository you want the agent to work on.
# If empty, the first run opens THIS repository for setup/testing only.
PROJECT_PATH=
# Optional one-time first task seed; leave blank to add tasks later.
INITIAL_TASK=
# Keep false until live integration and permission tests are complete.
AUTONOMOUS_ENABLED=false
WORKER_POLL_SECONDS=60
MAX_TASKS_PER_DAY=3
MAX_TASK_ATTEMPTS=2
TASK_TIMEOUT_SECONDS=1800
# Local acceptance command inside PROJECT_PATH, e.g. npm test or python -m pytest
TEST_COMMAND=
# Runs no shell commands outside a repository you explicitly configure.
# Use only on a trusted test project and after inspecting OpenCode permissions.
AUTONOMOUS_AUTO_APPROVE=false

# Outgoing owner notifications (optional). Gmail: 2FA + app password if available.
EMAIL_ENABLED=false
OWNER_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_APP_PASSWORD=
EMAIL_FROM=
